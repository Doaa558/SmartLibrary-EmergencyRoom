#include<iostream>
#include<limits>
using namespace std;
struct Book {
	int id;
	string title;
	string author;
	//constructor
	Book(int i, string t, string a) {
		id = i;
		title = t;
		author = a;
	}
	
};
struct Node {
	Node* left;
	Node* right;
	Book data;
	int height;
	//initialization 
	Node(Book b):data(b) {
		left = right = nullptr;
		height = 1;
	}
};
class AVL {
public:
	Node* root;
	AVL() {
		root = nullptr;
	}

	//height
	int getheight(Node* x) {
		if (x == nullptr) return 0;
		return x->height;
	}
	//balance
	int getbalance(Node* x) {
		if (x == nullptr) return 0;
		return getheight(x->left) - getheight(x->right);
	}
	//LL rotations
	Node* RightRotate(Node* x) {
		Node* y = x->left;
		Node* t = y->right;
		y->right = x;
		x->left = t;
		x->height = max(getheight(x->left), getheight(x->right)) + 1;
		y->height = max(getheight(y->left), getheight(y->right)) + 1;
		return y;
	}
	// RR rotations
	Node* LeftRotate(Node* x) {
		Node* y = x->right;
		Node* t = y->left;
		y->left = x;
		x->right = t;
		x->height = max(getheight(x->left), getheight(x->right)) + 1;
		y->height = max(getheight(y->left), getheight(y->right)) + 1;
		return y;
	}
	Node* insert(Node* node,Book b) {
		if (node == nullptr)
			return new Node(b);
		else if (b.id > node->data.id) {
			node->right = insert(node->right,b);
		}
		else if (b.id < node->data.id) {
			node->left = insert(node->left,b);

		}
		else {
			return node;
		}
		//update height
		node->height = max(getheight(node->left), getheight(node->right)) + 1;
		//update balance
		int balance = getbalance(node);
		//LL  comparison with the child
		if (getbalance(node) > 1 && b.id< node->left->data.id) {
			return RightRotate(node);
		}
		//RR
		else if (getbalance(node) < -1 && b.id > node->right->data.id) {
			return LeftRotate(node);
		}
		//LR
		else if (getbalance(node) > 1 && b.id > node->left->data.id) {
			node->left = LeftRotate(node->left);
			return RightRotate(node);
		}
		//RL
		else if (getbalance(node) < -1 && b.id < node->right->data.id) {
			node->right = RightRotate(node->right);
			return LeftRotate(node);
		}
		// if it still balanced with no rotations
		return node;
	}


	//search
	Node* search(Node* node, int id ) {
		if (node == nullptr || node->data.id == id) {
			return node;
		}
		else if (id > node->data.id) {
			return search(node->right, id);
		}
		else if (id < node->data.id) {
			return search(node->left, id);
		}
		// if key does not exist
		return nullptr;
	}
	//delete
	Node* deleteNode(Node* node,int id) {
		if (node == nullptr) {
			return node;
		}
		else if (id > node->data.id) {
			node->right = deleteNode(node->right,id);
		}
		else if (id < node->data.id) {
			node->left = deleteNode(node->left,id);
		}
		else {
			if (node->left == nullptr || node->right == nullptr) {
				// equal left if exist if not equal right
				Node* temp = node->left ? node->left : node->right;
				//leaf
				if (temp == nullptr) {
					temp = node;
					node = nullptr;
				}
				//one child
				else {
					*node = *temp;
				}
				delete temp;
			}
			// two childrens
			else {
				Node* temp = maxvalue(node->left);
				// copy all the data not just ids
				node->data= temp->data;
				// remove duplicates
				node->left = deleteNode(node->left,temp->data.id);

			}
			
		}
		if (node == nullptr) {
			return node;
		}
		//update height
		node->height = max(getheight(node->left), getheight(node->right)) + 1;
		//update balance
		int balance = getbalance(node);
		//LL
		if (getbalance(node) > 1 && getbalance(node->left)>=0) {
			return RightRotate(node);
		}
		//RR
		else if (getbalance(node) < -1 && getbalance(node->right)<=0) {
			return LeftRotate(node);
		}
		//LR
		else if (getbalance(node) > 1 && getbalance(node->left)<0) {
			node->left = LeftRotate(node->left);
			return RightRotate(node);
		}
		//RL
		else if (getbalance(node) < -1 && getbalance(node->right)>0) {
			node->right = RightRotate(node->right);
			return LeftRotate(node);
		}
		return node;
	}
	// get the max in the leftside
	Node* maxvalue(Node* node) {
		while (node->right != nullptr) {
			node = node->right;
		}
		return node;
	}
	// inorder left root right 
	void traverse(Node* node) {
		if (node != nullptr) {
			traverse(node->left);
			cout << node->data.id << " ";
			cout << node->data.title << " ";
			cout << node->data.author << " ";
			cout << endl;
			traverse(node->right);
		}
	}
};
